{
  "name": "ltxp",
  "displayName": "ltxp: instant LaTeX preview",
  "description": "Instant LaTeX preview in the browser with exact two-way SyncTeX, via the ltxp language server.",
  "version": "0.0.8",
  "publisher": "SichangHe",
  "license": "UPL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SichangHe/latex_live_preview"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:ltxp.openPreview"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ltxp.openPreview",
        "title": "ltxp: Open preview"
      },
      {
        "command": "ltxp.stop",
        "title": "ltxp: Stop preview"
      },
      {
        "command": "ltxp.forwardSearchHere",
        "title": "ltxp: Show cursor position in preview"
      },
      {
        "command": "ltxp.openLog",
        "title": "ltxp: Open LaTeX log"
      },
      {
        "command": "ltxp.toggleSync",
        "title": "ltxp: Toggle preview following the cursor"
      }
    ],
    "configuration": {
      "title": "ltxp",
      "properties": {
        "ltxp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ltxp executable; empty searches PATH and ~/.local/bin."
        },
        "ltxp.cursorDelayMs": {
          "type": "number",
          "default": 100,
          "description": "Delay before moving the preview marker after the cursor moves."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
